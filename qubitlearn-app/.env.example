# =========================================================================
# QUBITLEARN AI — ENVIRONMENT CONFIGURATION
# Production Cloud Infrastructure: Google Cloud Vertex AI + Supabase Cloud
# =========================================================================

# Google Cloud Vertex AI & Google Gemini Configuration
GOOGLE_GENAI_USE_VERTEXAI="true"
GOOGLE_CLOUD_PROJECT="your-google-cloud-project-id"
GOOGLE_CLOUD_LOCATION="global"
GEMINI_API_KEY="your_gemini_api_key_here"

# Supabase Cloud Database & Authentication
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"
SUPABASE_SECRET_KEY="sb_secret_your_service_role_key_here"
SUPABASE_DB_PASSWORD="your_database_password_here"

# Quantum Code Sandbox & Compute Engine VM Configuration
# QUANTUM_EXECUTION_MODE options:
#   - FIRECRACKER_KVM    : Hardware KVM microVMs (Compute Engine N2 VM /dev/kvm or WSL2)
#   - BINARY_RUNTIME     : Standalone precompiled quantum SDK binaries (.bin) on standard VM (e.g., e2-micro/e2-medium)
#   - CLOUD_RUN_SANDBOX  : Google Cloud Run isolated container sandbox
#   - IN_MEMORY_V8       : Node.js V8 context sandbox (zero external compute cost)
QUANTUM_EXECUTION_MODE="FIRECRACKER_KVM"

# VM Provider Identifier: GCP_N2_KVM | GCP_E2 | CLOUD_RUN | LOCAL_WSL2 | AUTO
VM_PROVIDER="GCP_N2_KVM"

# Dedicated Compute Engine N2 Firecracker daemon endpoint (internal VPC URL)
# Example: http://10.128.0.2:8080 or http://firecracker-vm.internal:8080
FIRECRACKER_SERVICE_URL=""

# Path to precompiled standalone SDK binaries (.bin) if using BINARY_RUNTIME mode
SDK_BINARY_DIR="./bin"

# Resource Limits
SANDBOX_MEMORY_LIMIT_MB="128"
SANDBOX_TIMEOUT_MS="3000"

# Application URL
APP_URL="http://localhost:3000"
