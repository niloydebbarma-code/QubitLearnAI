# ==============================================================================
# QubitLearn AI - Git Ignore Configuration
# ==============================================================================

# Node dependencies & caches
node_modules/
.npm/
.npm-render-cache/
bun.lock

# Environment variables & API keys (Protects against unauthorized cloud/AI bills)
.env
.env.*
!.env.example
credentials.json
service-account*.json
*.pem
*.key
*.crt

# Build outputs
dist/
build/
.next/
out/
.vercel/

# Private Backup & Internal Documents
backup/
*_backup*/
backup_private/

# Exclude presentation decks & source slides from public GitHub (Internal jury use only)
presentation/
presentation copy/
presentation - Copy/
*.pdf
*.pptx

# Exclude video assets, raw recordings, and Manim rendering caches
video_assets/
media/
*.mp4
*.avi
*.mov
*.mkv
*.webm

# Temporary, archive & log files
*.zip
*.tar.gz
*.bak
*.tmp
*.temp
*.swp
*.swo
*~
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
log_snap/

# Python cache
__pycache__/
*.py[cod]
.pytest_cache/

# OS and IDE specific files
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# Local database files
*.sqlite
*.sqlite3
*.db
